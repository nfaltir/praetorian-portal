# Copy to .env.local and fill in. Production values go in Vercel project settings.

# Neon: use the POOLED connection string (host contains "-pooler"), with sslmode=require
DATABASE_URL=postgres://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require

# 32+ random bytes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# Public URL of the site, no trailing slash (http://localhost:3000 locally)
BETTER_AUTH_URL=http://localhost:3000
